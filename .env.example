# Supabase (Catálogo de salas em tempo real e backend do Lobby - Fase L2)
# Crie um projeto gratuito em https://supabase.com e execute a migration em supabase/migrations/20261103_init_lobby.sql
# Se omitidas, o Ping utiliza automaticamente o MockRoomService com dados locais de demonstração.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# VITE_MOCK_ROOMS=true (opcional: força uso do mock mesmo com Supabase configurado)

# TURN opcional (necessário para ~10-20% das redes: CGNAT, NAT simétrico)
# ATENÇÃO: Variáveis VITE_* são embutidas no bundle e ficam visíveis no navegador.
# Nunca reutilize senhas pessoais; use credenciais TURN temporárias ou com limite de cota/domínio.
# Separe várias URLs por vírgula (ex.: turn:seu-turn.com:3478,turns:seu-turn.com:443?transport=tcp).
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# PeerServer próprio (opcional). Vazio = usa o PeerJS Cloud público.
VITE_PEER_HOST=
VITE_PEER_PORT=443
VITE_PEER_PATH=/
VITE_PEER_SECURE=true
