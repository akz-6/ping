# ==============================================================================
# Ping v2 — Variáveis de Ambiente & Configuração
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Administração do Dono & Segurança do Servidor
# ------------------------------------------------------------------------------
# Chave mestra validada exclusivamente no servidor (api/rooms.ts) para criação de
# salas além do limite global de capacidade.
OWNER_KEY=0604

# IDs de usuários do Discord que possuem privilégios de anfitrião/dono.
# Usuários autenticados no Discord com esses IDs criam salas sem precisar da chave.
# Vários IDs separados por vírgula. Ex.: 123456789012345678,987654321098765432
OWNER_DISCORD_IDS=

# Segredo criptográfico para assinatura HMAC-SHA256 das sessões e tickets (min 32 bytes).
SESSION_SECRET=substitua-por-um-segredo-forte-e-aleatorio-com-pelo-menos-32-caracteres

# ------------------------------------------------------------------------------
# 2. Autenticação Discord (OAuth2 v10)
# ------------------------------------------------------------------------------
# Crie uma aplicação em https://discord.com/developers/applications
# Cadastre o Redirect URI fixo no portal do Discord:
# - Produção: https://seu-dominio.com.br/api/discord-auth?action=callback
# - Desenvolvimento local: http://localhost:5173/api/discord-auth?action=callback
# OBS: O Discord não aceita curingas (*) — URLs de preview da Vercel não são suportadas pelo OAuth2 do Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/discord-auth?action=callback

# ------------------------------------------------------------------------------
# 3. Cloudflare Calls (WebRTC SFU Anycast Serverless)
# ------------------------------------------------------------------------------
# Obtenha em Cloudflare Dashboard -> Calls -> Criar Aplicação
# Permite transmissão 1-para-muitos furando qualquer CGNAT na porta 443 HTTPS.
# Cota gratuita: até 1 Terabyte (1.000 GB) por mês.
CF_CALLS_APP_ID=
CF_CALLS_APP_SECRET=

# Modo de transporte padrão:
# - auto: testa a saúde da Cloudflare; se disponível usa SFU, senão cai para P2P (Recomendado).
# - p2p: força conexão PeerJS direta ponto a ponto com fallback TURN.
# - sfu: força Cloudflare Calls sem fallback inicial de health.
VITE_TRANSPORT_MODE=auto

# ------------------------------------------------------------------------------
# 4. Servidores TURN / STUN (Metered.ca / OpenRelay)
# ------------------------------------------------------------------------------
# Utilizado no fallback P2P para atravessar firewalls simétricos e CGNAT.
# Crie uma conta gratuita em https://www.metered.ca/tools/openrelay/
METERED_DOMAIN=
METERED_API_KEY=

# TURN estático opcional (fallback secundário)
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ------------------------------------------------------------------------------
# 5. Monetização Google AdSense (Somente Lobby)
# ------------------------------------------------------------------------------
# ID de cliente do Google AdSense (ex.: ca-pub-XXXXXXXXXXXXXXXX)
# O script prebuild gera automaticamente public/ads.txt a partir desta variável.
# Exigência do Google: o AdSense não aprova domínios *.vercel.app. Registre um domínio próprio
# (.com ou .com.br) e aponte para a Vercel antes de submeter à aprovação.
VITE_ADSENSE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 6. Catálogo de Salas & Supabase (Lobby)
# ------------------------------------------------------------------------------
# Opcional: Se omitidas, o Ping utiliza automaticamente o MockRoomService local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 7. PeerServer Próprio (Opcional)
# ------------------------------------------------------------------------------
# Vazio = utiliza o PeerJS Cloud público padrão.
VITE_PEER_HOST=
VITE_PEER_PORT=443
VITE_PEER_PATH=/
VITE_PEER_SECURE=true
